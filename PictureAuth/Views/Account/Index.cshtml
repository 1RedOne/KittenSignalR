@model PictureAuth.Models.RegisterDto

@{
    ViewData["Title"] = "Home Page";
}


<h4>RegisterDto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Register">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @{Html.RenderPartial("_AnimalSelector");}
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" id="Password" class="form-control" type="password"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="dobYear" class="control-label">Date of Birth</label>
                <div class="d-flex gap-2">
                    <!-- Month Dropdown -->
                    <select id="dobMonth" class="form-control" required>
                        <option value="" disabled selected>Month</option>
                        @for (int month = 1; month <= 12; month++)
                        {
                            <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                    </select>

                    <!-- Day Dropdown -->
                    <select id="dobDay" class="form-control" required>
                        <option value="" disabled selected>Day</option>
                        @for (int day = 1; day <= 31; day++)
                        {
                            <option value="@day">@day</option>
                        }
                    </select>

                    <!-- Year Dropdown -->
                    <select id="dobYear" class="form-control" required>
                        <option value="" disabled selected>Year</option>
                        @for (int year = DateTime.Now.Year - 50; year <= DateTime.Now.Year; year++)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="button" value="Create" class="btn btn-primary" onclick="Registration()" />
        </form>
        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }


        <script>
            console.log("Reloaded form");

            // Define the Registration method
            async function Registration() {
                console.log("Registration method called");

                const name = document.querySelector('[name="Name"]').value;
                const password = document.querySelector('[name="Password"]').value;

                const month = document.getElementById('dobMonth').value;
                const day = document.getElementById('dobDay').value;
                const year = document.getElementById('dobYear').value;

                if (!month || !day || !year) {
                    alert('Please complete your date of birth.');
                    return;
                }

                const dateOfBirth = `${year}-${month}-${day} 00:01 AM`;


                const data = {
                    name: name,
                    password: password,
                    dateOfBirth: dateOfBirth,
                    id: 0
                };

                try {
                    const response = await fetch('/Account/registerMe', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        alert('Registration successful!');
                    } else {
                        const error = await response.json();
                        alert(`Registration failed: ${error.Message}`);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred during registration.');
                }
            }
        </script>

        <style>
            .selection-container {
                display: flex;
                gap: 20px; /* Padding between boxes */
                flex-wrap: wrap;
                justify-content: center;
            }

            .box {
                width: 120px;
                height: 120px;
                border: 2px solid #ccc;
                border-radius: 8px;
                cursor: pointer;
                text-align: center;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .box img {
                width: 100px;
                height: 100px;
            }

            .box.color {
                background-color: transparent;
            }

            .box.selected {
                border-color: #007bff;
                box-shadow: 2px 2px 10px rgba(0, 123, 255, 0.5);
                transform: scale(1.1);
            }
        </style>
