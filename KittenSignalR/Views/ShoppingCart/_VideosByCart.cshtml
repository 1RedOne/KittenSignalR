@model List<Video>

@if (Model != null && Model.Any())
{
    <h3>Your cart contains...</h3>
    <p>Found @Model.Count() videos</p>
    <ul class="list-group">
        @foreach (var video in Model)
        {
            
            <li class="list-group-item">
                <div class="d-flex align-items-center">
                    <!-- Thumbnail -->
                    <img src="@video.VideoThumbnail" alt="@video.VideoTitle Thumbnail" class="img-thumbnail" style="width: 100px; height: auto; margin-right: 10px;" />

                    <!-- Video Details -->
                    <div>
                        <h5>[@video.CreatorChannelName] - @video.VideoTitle</h5>
                        <p class="mb-1">
                            @(
                                @video.VideoDescription.Length > 300
                                ? @video.VideoDescription.Substring(0, 300) + "..."
                                : @video.VideoDescription
                                )
                        </p>
                        <small>Length: @TimeSpan.FromSeconds(video.VideoLength).ToString(@"hh\:mm\:ss")</small><p>Published @video.GetDateAgo()</p><br />
                        <a href="@video.VideoUrl" class="btn btn-sm btn-primary mt-2" target="_blank">Watch Video</a>
                        <button class="btn btn-danger"
                                onclick="invokeShoppingMethod('@video.VideoId', 'removeFromCart')">
                            Remove From Cart
                        </button>                        
                    </div>
                </div>
            </li>
        }
    </ul>
}
else
{
    <p>No videos In your cart yet, get shopping!</p>
}

