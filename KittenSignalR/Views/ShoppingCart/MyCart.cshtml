@model KittenSignalR.Models.ShoppingCart

@{
    ViewData["Title"] = $"My Shopping Cart";
}

<div>
    <h4>ShoppingCart</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActiveOrder)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActiveOrder)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderApproved)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderApproved)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderFulfilled)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderFulfilled)
        </dd>
    </dl>
</div>

<!-- Placeholder for the partial view -->
<div id="videosContainer" class="mt-4">    
    @Html.Partial("_VideosByCart", @Model.OrderItems)
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.OrderNumberId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

