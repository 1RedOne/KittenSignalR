@model List<CreatorVideos>
@{
    ViewData["Title"] = $"Youtube View of all Creators";
}

<div class="container">
    @foreach (var creatorGroup in Model)
    {
        <div class="creator-section">
            <h2>
                <a class="btn btn-warning" href="/@creatorGroup.CreatorName">@creatorGroup.CreatorName</a>
                <button class="btn btn-primary"
                        onclick="invokeCreatorMethod('@creatorGroup.CreatorName', 'fiveMore')">
                    More Videos
                </button>
                <span style="font-size: smaller; margin-left: 10px;">Found @creatorGroup.Videos.Count videos</span>
            </h2>
            <div class="video-carousel">
                @foreach (var video in creatorGroup.Videos)
                {
                    <div class="video-card">
                        <img src="@video.VideoThumbnail" alt="Thumbnail" />
                        <a href="@video.VideoId"><h4>@video.VideoTitle</h4></a>
                        <p>Published @video.GetDateAgo()</p>
                        <button class="btn btn-success add-to-cart"
                                onclick="invokeItemMethod('@video.VideoId', 'addToCart')">
                            🛒 Add to cart
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .container {
        padding: 20px;
    }

    .creator-section {
        margin-bottom: 40px;
    }

    .video-carousel {
        display: flex;
        overflow-x: auto;
        gap: 20px;
    }

    .video-card {
        position: relative; /* This confines absolute positioning inside this card */

        flex: 0 0 auto;
        width: 200px;
        background: #f4f4f4;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .video-card img {
        width: 100%;
        border-radius: 4px;
    }

    .add-to-cart {
        position: absolute;
        bottom: 10px;
        right: 10px;
        font-size: 14px;
        padding: 8px 12px;
        border: none;
        border-radius: 3px;
    }

    .video-card h4 {
        font-size: 16px;
        margin: 10px 10px 5px;
            color: #555;
    }

    .video-card p {
        font-size: 14px;
        color: #555;
    }

    .video-carousel::-webkit-scrollbar {
        height: 6px;
    }

    .video-carousel::-webkit-scrollbar-thumb {
        background-color: #aaa;
        border-radius: 3px;
    }
</style>
<script>
    function invokeCreatorMethod(channelUrl, method) {
        const requestUrl = `${channelUrl}/${method}`;

        // Send the PUT request
        fetch(requestUrl, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            // Optionally include a body if your API expects data
            body: JSON.stringify({ reason: 'User initiated deletion' }),
        })
            .then(response => {
                if (response.ok) {
                    alert('Creator ${method} called successfully!');
                    // Optionally refresh the page or redirect
                    window.location.reload();
                } else {
                    alert('Failed to ${method} this creator.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while trying to ${method} the creator.');
            });
    }
</script>