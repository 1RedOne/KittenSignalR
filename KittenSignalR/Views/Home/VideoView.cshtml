@model Video
@{
    ViewData["Title"] = $"View of {Model.VideoTitle}";
}

<div class="container mt-4" id="creatorThumbnailAndDetails">
    <h1>@Model.VideoTitle</h1>
    <div class="card" style="width: 100%; max-width: 600px; margin: auto;">
        <img class="card-img-top"
             src="@Model.VideoThumbnail"
             alt="Thumbnail"
             style="width: 100%; height: auto; object-fit: cover;">
        <div class="card-body">            
            <p class="card-text"><pre>@Model.VideoDescription</pre></p>
            <a href="@Model.CreatorChannelName" class="btn btn-info" target="_blank">Visit Channel</a>
            <button class="btn btn-success add-to-cart"
                    onclick="invokeShoppingMethod('@Model.VideoUrl', 'addToCart')">
                🛒 Add all videos to cart
            </button>
        </div>
    </div>
    <!-- Placeholder for the partial view -->
    <div id="videosContainer" class="mt-4">
        <h3>Loading videos...</h3>
    </div>
</div>

<script>
    // Load the partial view dynamically
    document.addEventListener("DOMContentLoaded", function () {
        const handle = "@Model.CreatorChannelName"; // Use the ChannelId as the handle
        fetch(`/Home/GetVideosByCreatorHandle?handle=${encodeURIComponent(handle)}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById("videosContainer").innerHTML = html;
            })
            .catch(error => {
                console.error("Error loading videos:", error);
                document.getElementById("videosContainer").innerHTML = "<p>Failed to load videos.</p>";
            });
    });

    
</script>