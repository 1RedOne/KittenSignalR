@model List<PictureAuth.Models.RegisterDto>

@{
    ViewData["Title"] = "Login";
}

<style>
    .user-button {
        padding: 10px 20px;
        margin: 5px;
        font-size: 16px;
        border: 2px solid #007bff;
        background-color: #f9f9f9;
        cursor: pointer;
        border-radius: 8px;
        transition: background-color 0.2s, color 0.2s;
    }

        .user-button:hover {
            background-color: #007bff;
            color: white;
        }

        .user-button.selected {
            background-color: #007bff;
            color: white;
            font-weight: bold;
        }
</style>

<h4>Sign in</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Login">
            <h1>Select a User</h1>
            <div id="userList">
                @foreach (var user in Model)
                {
                    <div class="box user" data-username="@user.Name" style="background-color: teal;">@user.Name</div>                    
                }
                <p id="selectedUserDisplay">Selected User: <strong id="selectedUser"></strong></p>
            </div>            
            
                @{
                    Html.RenderPartial("_AnimalSelector");
                }            

            <div class="form-group">
                <input id="Password" class="form-control" type="password" hidden/>
            </div>           
            <div class="form-group">
                <input type="button" value="Login" class="btn btn-primary" onclick="Registration()" />
        </form>


        <script>
            console.log("Reloaded form");
                let userName = null;

                // Add event listeners to all user buttons
            // document.querySelectorAll('.box user').forEach(button => {
            document.querySelectorAll("#userList > div").forEach(button => {
                button.addEventListener('click', () => {
                    // Deselect all buttons
                    document.querySelectorAll('.box user').forEach(btn => btn.classList.remove('selected'));

                    // Select the clicked button
                    button.classList.add('selected');

                    // Update the userName variable
                    userName = button.dataset.username;

                    // Update the display
                    document.getElementById('selectedUser').textContent = userName;

                    console.log('Selected User:', userName);

                    // Update the display
                    document.getElementById('selectedUser').textContent = userName;

                    console.log('Selected User:', userName);
                });
            });


            // Define the Registration method
            async function Registration() {
                console.log("Registration method called");

                const name = userName;
                const password = resultantPassword;


                const dateOfBirth = `2024-02-01 00:01 AM`;


                const data = {
                    name: name,
                    password: password,
                    dateOfBirth: dateOfBirth,
                    id: 0
                };

                try {
                    const response = await fetch('/Account/logMeIn', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data),
                    });
                    
                    const respVal = await response.json();
                    if (respVal.statusCode != 401) {
                        alert('Login Succeeded!');
                        window.location.href = '/Account/MyAccount';

                    } else {
                        const error = respVal;
                        alert(`Login  failed: ${error.Value}`);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert(`Login  failed: ${error.Value}`);
                }
            }
            
        </script>

        <style>
            .selection-container {
                display: flex;
                gap: 20px; /* Padding between boxes */
                flex-wrap: wrap;
                justify-content: center;
            }

            .box {
                width: 120px;
                height: 120px;
                border: 2px solid #ccc;
                border-radius: 8px;
                cursor: pointer;
                text-align: center;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .box img {
                width: 100px;
                height: 100px;
            }

            .box.color {
                background-color: transparent;
            }

            .box.selected {
                border-color: #007bff;
                box-shadow: 2px 2px 10px rgba(0, 123, 255, 0.5);
                transform: scale(1.1);
            }
        </style>
        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
